REDIS_EXPORTER_PASSWORD=openIM123
MONGO_EXPORTER_URI=mongodb://openIM:openIM123@127.0.0.1:37017/openim_v3?authSource=openim_v3

TEMPO_IMAGE=grafana/tempo:2.4.1
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:0.96.0
