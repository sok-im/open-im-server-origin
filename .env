NODE_EXPORTER_PORT=19100
REDIS_EXPORTER_IMAGE=oliver006/redis_exporter:v1.62.0
MONGO_EXPORTER_IMAGE=percona/mongodb_exporter:0.40.0
REDIS_EXPORTER_PORT=19150
MONGO_EXPORTER_PORT=19160
