#OPENIM_ADMIN_FRONT_IMAGE=registry.cn-hangzhou.aliyuncs.com/openimsdk/openim-admin-front:release-v1.8.4

DATA_DIR=./

MONGO_BACKUP_DIR=${DATA_DIR}components/backup/mongo/

