{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Cron Tasks",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "options": { "0": { "color": "red", "text": "DOWN" }, "1": { "color": "green", "text": "UP" } }, "type": "value" }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "up{job=\"openimserver-openim-crontask\"}", "refId": "A" }],
      "title": "crontask target",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 9, "x": 6, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (task, result) (rate(cron_task_runs_total[5m]))",
          "legendFormat": "{{task}} {{result}}",
          "refId": "A"
        }
      ],
      "title": "Cron Runs",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 1 },
      "id": 4,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, task) (rate(cron_task_duration_seconds_bucket[15m])))",
          "legendFormat": "{{task}} p95",
          "refId": "A"
        }
      ],
      "title": "Cron Duration p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "dateTimeAsIso" } },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "targets": [
        {
          "expr": "cron_task_last_success_unixtime * 1000",
          "legendFormat": "{{task}}",
          "refId": "A"
        }
      ],
      "title": "Last Success Time",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["openim", "cron"],
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "OpenIM CronTask",
  "uid": "openim-crontask",
  "version": 1
}
