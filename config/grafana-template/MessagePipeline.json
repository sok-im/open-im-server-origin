      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Message Pipeline",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        { "expr": "sum(rate(single_chat_msg_process_success_total[1m]))", "legendFormat": "single success", "refId": "A" },
        { "expr": "sum(rate(group_chat_msg_process_success_total[1m]))", "legendFormat": "group success", "refId": "B" },
        { "expr": "sum(rate(single_chat_msg_process_failed_total[1m]))", "legendFormat": "single failed", "refId": "C" },
        { "expr": "sum(rate(group_chat_msg_process_failed_total[1m]))", "legendFormat": "group failed", "refId": "D" }
      ],
      "title": "rpc-msg Process QPS",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 3,
      "targets": [
        {
          "expr": "sum by (consumergroup, topic) (kafka_consumergroup_lag{job=\"kafka_exporter\"})",
          "legendFormat": "{{consumergroup}} / {{topic}}",
          "refId": "A"
        }
      ],
      "title": "Kafka Consumer Lag",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 4,
      "targets": [
        { "expr": "sum(rate(msg_insert_redis_success_total[1m]))", "legendFormat": "redis success", "refId": "A" },
        { "expr": "sum(rate(msg_insert_redis_failed_total[1m]))", "legendFormat": "redis failed", "refId": "B" },
        { "expr": "sum(rate(msg_insert_mongo_success_total[1m]))", "legendFormat": "mongo success", "refId": "C" },
        { "expr": "sum(rate(msg_insert_mongo_failed_total[1m]))", "legendFormat": "mongo failed", "refId": "D" },
        { "expr": "sum(rate(seq_set_failed_total[1m]))", "legendFormat": "seq failed", "refId": "E" }
      ],
      "title": "msgtransfer Persist",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "id": 5,
      "targets": [
        { "expr": "sum(rate(msg_offline_push_failed_total[1m]))", "legendFormat": "offline push failed", "refId": "A" },
        { "expr": "sum(rate(msg_long_time_push_total[1m]))", "legendFormat": "slow push >10s", "refId": "B" }
      ],
      "title": "Push Failures / Slow Push",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 17 },
      "id": 6,
      "targets": [{ "expr": "online_user_num", "legendFormat": "online users", "refId": "A" }],
      "title": "Online Users (msggateway)",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 17 },
