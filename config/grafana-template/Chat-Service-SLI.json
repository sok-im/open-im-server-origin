  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Chat API SLI",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "id": 2,
      "targets": [
        { "expr": "sum(rate(api_count{job=~\"openimchat-api-.*\"}[1m]))", "legendFormat": "total", "refId": "A" },
        { "expr": "sum by (job) (rate(api_count{job=~\"openimchat-api-.*\"}[1m]))", "legendFormat": "{{job}}", "refId": "B" }
      ],
      "title": "API QPS by Job",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 1 },
      "id": 3,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(api_request_duration_seconds_bucket{job=~\"openimchat-api-.*\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(api_request_duration_seconds_bucket{job=~\"openimchat-api-.*\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(api_request_duration_seconds_bucket{job=~\"openimchat-api-.*\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "API Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(api_count{job=~\"openimchat-api-.*\",code!=\"0\"}[5m])) / clamp_min(sum(rate(api_count{job=~\"openimchat-api-.*\"}[5m])), 0.001)",
          "legendFormat": "error rate",
          "refId": "A"
        }
      ],
      "title": "API Error Rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 5,
      "title": "Chat RPC SLI",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "id": 6,
      "targets": [
        { "expr": "sum by (job) (rate(rpc_count{job=~\"openimchat-rpc-.*\"}[1m]))", "legendFormat": "{{job}}", "refId": "A" }
      ],
      "title": "RPC QPS by Job",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "id": 7,
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(rpc_request_duration_seconds_bucket{job=~\"openimchat-rpc-.*\"}[5m])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(rpc_request_duration_seconds_bucket{job=~\"openimchat-rpc-.*\"}[5m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(rpc_request_duration_seconds_bucket{job=~\"openimchat-rpc-.*\"}[5m])))", "legendFormat": "p99", "refId": "C" }
      ],
      "title": "RPC Latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "id": 8,
      "targets": [
        { "expr": "topk(10, sum by (job, path, code) (rate(rpc_count{job=~\"openimchat-rpc-.*\",code!=\"0\"}[5m])))", "legendFormat": "{{job}} {{path}} code={{code}}", "refId": "A" }
      ],
      "title": "RPC Errors Top Methods",
      "type": "timeseries"
    }
