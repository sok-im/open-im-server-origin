[
  {
    "type": "function",
    "name": "getSignMessage",
    "inputs": [
      { "name": "packetId",  "type": "uint256" },
      { "name": "claimer",   "type": "address" },
      { "name": "authNonce", "type": "uint256" },
      { "name": "randomSeed","type": "uint256" },
      { "name": "deadline",  "type": "uint256" }
    ],
    "outputs": [{ "name": "", "type": "bytes32" }],
    "stateMutability": "view"
  },
  {
    "type": "function",
    "name": "setSigner",
    "inputs": [{ "name": "newSigner", "type": "address" }],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "setAllowAllTokens",
    "inputs": [{ "name": "allowed", "type": "bool" }],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "setNativeTokenEnabled",
    "inputs": [{ "name": "enabled", "type": "bool" }],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "setAllowedToken",
    "inputs": [
      { "name": "token",          "type": "address" },
      { "name": "allowed",        "type": "bool" },
      { "name": "minShareAmount", "type": "uint256" }
    ],
    "outputs": [],
    "stateMutability": "nonpayable"
  },
  {
    "type": "function",
    "name": "setDefaultExpiryDuration",
    "inputs": [{ "name": "duration", "type": "uint256" }],
    "outputs": [],
