# OpenIM
OPENIM_API=http://127.0.0.1:10002
OPENIM_ADMIN_USER=imAdmin
OPENIM_ADMIN_SECRET=openIM123
OPENIM_ADMIN_TOKEN=
BOT_USER_ID=openIMChatbot
BOT_NICKNAME=在线客服

# Optional: when set, POST /callbackAfterSendMsgToBotCommand requires header X-Callback-Secret
CALLBACK_SECRET=

# LLM (OpenAI-compatible)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding (empty EMBED_BASE_URL / EMBED_API_KEY fall back to LLM_*)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# RAG / storage
CHROMA_PATH=./data/chroma
KNOWLEDGE_DIR=./knowledge
SIMILARITY_TOP_K=4
ADMIN_REINDEX_TOKEN=change-me

# Idempotency: only `memory` is implemented (single process).
# `redis` raises NotImplementedError — not for multi-instance yet.
IDEMPOTENCY_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0

# Fallback replies
FALLBACK_NO_HIT=暂未查到相关说明，请换个问法或联系人工客服。
FALLBACK_BUSY=客服繁忙，请稍后再试。
